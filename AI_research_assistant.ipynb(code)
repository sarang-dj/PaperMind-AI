      "source": [
        "pdf_path=\"/content/MAJOR.pdf\"\n",
        "def extract_text_from_pdf(pdf_path):\n",
        "    document = pymupdf.open(pdf_path)\n",
        "\n",
        "    pages = []\n",
        "\n",
        "\n",
        "    for page_number, page in enumerate(document):\n",
        "        text = page.get_text()\n",
        "\n",
        "        if text.strip():\n",
        "            pages.append({\n",
        "                \"page\": page_number + 1,\n",
        "                \"text\": text\n",
        "            })\n",
        "\n",
        "    document.close()\n",
        "\n",
        "    return pages"
