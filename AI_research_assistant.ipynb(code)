        "def create_chunks(pages, chunk_size=1000, overlap=200):\n",
        "    chunks = []\n",
        "\n",
        "    for page in pages:\n",
        "        text = page[\"text\"]\n",
        "\n",
        "        start = 0\n",
        "\n",
        "        while start < len(text):\n",
        "            end = min(start + chunk_size, len(text))\n",
        "\n",
        "            chunk_text = text[start:end].strip()\n",
        "\n",
        "            if chunk_text:\n",
        "                chunks.append({\n",
        "                    \"text\": chunk_text,\n",
        "                    \"page\": page[\"page\"]\n",
