        "def hybrid_search(query, top_k=5):\n",
        "\n",
        "    # -----------------------------------\n",
        "    # 1. Semantic search\n",
        "    # -----------------------------------\n",
        "\n",
        "    query_embedding = embedding_model.encode(\n",
        "        [query],\n",
        "        normalize_embeddings=True,\n",
        "        convert_to_numpy=True\n",
        "    )\n",
        "\n",
        "    semantic_scores, indices = index.search(\n",
        "        query_embedding.astype(\"float32\"),\n",
        "        len(chunks)\n",
        "    )\n",
        "\n",
        "    candidates = []\n",
        "\n",
        "    # -----------------------------------\n",
        "    # 2. Calculate combined score\n",
        "    # -----------------------------------\n",
        "\n",
        "    for semantic_score, idx in zip(\n",
        "        semantic_scores[0],\n",
        "        indices[0]\n",
        "    ):\n",
        "\n",
        "        chunk = chunks[idx]\n",
        "\n",
        "        text = chunk[\"text\"]\n",
        "\n",
        "        # Keyword similarity\n",
        "        k_score = keyword_score(\n",
        "            query,\n",
        "            text\n",
        "        )\n",
        "\n",
        "        # -----------------------------------\n",
        "        # Section keyword bonus\n",
        "        # -----------------------------------\n",
        "\n",
        "        section_bonus = 0.0\n",
        "\n",
        "        query_lower = query.lower()\n",
        "        text_lower = text.lower()\n",
        "\n",
        "        if \"objective\" in query_lower:\n",
        "\n",
        "            if (\n",
        "                \"objective\" in text_lower\n",
        "                or \"primary goal\" in text_lower\n",
        "                or \"aim\" in text_lower\n",
        "                or \"purpose\" in text_lower\n",
        "            ):\n",
        "                section_bonus = 0.5\n",
        "\n",
        "        elif \"methodology\" in query_lower:\n",
        "\n",
        "            if (\n",
        "                \"methodology\" in text_lower\n",
        "                or \"method\" in text_lower\n",
        "                or \"approach\" in text_lower\n",
        "            ):\n",
        "                section_bonus = 0.5\n",
        "\n",
        "        elif \"conclusion\" in query_lower:\n",
        "\n",
        "            if (\n",
        "                \"conclusion\" in text_lower\n",
        "                or \"conclusive remarks\" in text_lower\n",
        "                or \"future scope\" in text_lower\n",
        "            ):\n",
        "                section_bonus = 0.5\n",
        "\n",
        "        # -----------------------------------\n",
        "        # Final score\n",
        "        # -----------------------------------\n",
        "\n",
        "        final_score = (\n",
        "            0.5 * float(semantic_score)\n",
        "            + 0.3 * k_score\n",
        "            + 0.2 * section_bonus\n",
        "        )\n",
        "\n",
        "        candidates.append({\n",
        "            \"text\": text,\n",
        "            \"page\": chunk[\"page\"],\n",
        "            \"semantic_score\": float(semantic_score),\n",
        "            \"keyword_score\": k_score,\n",
        "            \"section_bonus\": section_bonus,\n",
        "            \"final_score\": final_score\n",
        "        })\n",
        "\n",
        "    # -----------------------------------\n",
        "    # 3. Sort by final score\n",
        "    # -----------------------------------\n",
        "\n",
        "    candidates.sort(\n",
        "        key=lambda x: x[\"final_score\"],\n",
        "        reverse=True\n",
        "    )\n",
        "\n",
        "    return candidates[:top_k]"
