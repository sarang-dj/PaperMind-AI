        "import torch\n",
        "\n",
        "def answer_question(question, context):\n",
        "\n",
        "    inputs = tokenizer(\n",
        "        question,\n",
        "        context,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        max_length=512,\n",
        "        return_offsets_mapping=True\n",
        "    )\n",
        "\n",
        "    # Keep offset mapping separately\n",
        "    offset_mapping = inputs.pop(\"offset_mapping\")\n",
        "\n",
        "    # Identify which tokens belong to the context\n",
        "    sequence_ids = inputs.sequence_ids(0)\n",
        "\n",
        "    context_token_positions = [\n",
        "        i for i, seq_id in enumerate(sequence_ids)\n",
        "        if seq_id == 1\n",
        "    ]\n",
        "\n",
        "    if not context_token_positions:\n",
        "        return {\n",
        "            \"answer\": \"\",\n",
        "            \"score\": 0.0\n",
        "        }\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = qa_model(**inputs)\n",
        "\n",
        "    start_logits = outputs.start_logits[0]\n",
        "    end_logits = outputs.end_logits[0]\n",
        "\n",
        "    # Only consider tokens belonging to the context\n",
        "    best_answer = \"\"\n",
        "    best_score = 0.0\n",
        "\n",
        "    for start in context_token_positions:\n",
        "\n",
        "        for end in context_token_positions:\n",
        "\n",
        "            # Don't allow backwards spans\n",
        "            if end < start:\n",
        "                continue\n",
        "\n",
        "            # Don't allow extremely long answers\n",
        "            if end - start > 30:\n",
        "                continue\n",
        "\n",
        "            score = (\n",
        "                float(start_logits[start])\n",
        "                + float(end_logits[end])\n",
        "            )\n",
        "\n",
        "            if score > best_score:\n",
        "\n",
        "                start_char = offset_mapping[0][start][0].item()\n",
        "                end_char = offset_mapping[0][end][1].item()\n",
        "\n",
        "                answer = context[start_char:end_char].strip()\n",
        "\n",
        "                if answer:\n",
        "\n",
        "                    best_answer = answer\n",
        "                    best_score = score\n",
        "\n",
        "    return {\n",
        "        \"answer\": best_answer,\n",
        "        \"score\": best_score\n",
        "    }"
